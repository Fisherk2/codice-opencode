{
  "name": "@fisherk2-dev/codice",
  "version": "2.1.0-beta.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fisherk2/codice-opencode"
  },
  "module": "src/cli/main.ts",
  "type": "module",
  "bin": {
    "codice": "./src/cli/bin.js"
  },
  "files": [
    "src/",
    "template/",
    "package.json",
    "tsconfig.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/bun": "^1.3.14",
    "@types/semver": "^7.8.0",
    "typescript": "^6.0.3",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "dev": "bun run src/cli/main.ts --verbose",
    "test": "bun test tests/ --path-ignore-patterns=template/obligatorio/core/skills/**,skills/**",
    "test:unit": "bun test tests/unit/ --path-ignore-patterns=template/obligatorio/core/skills/**,skills/**",
    "test:integration": "bun test tests/integration/ --path-ignore-patterns=template/obligatorio/core/skills/**,skills/**",
    "test:coverage": "bun test tests/ --coverage --path-ignore-patterns=template/obligatorio/core/skills/**,skills/**",
    "lint": "bunx @biomejs/biome check src/ tests/",
    "format": "bunx @biomejs/biome format --write src/ tests/",
    "format:check": "bunx @biomejs/biome ci src/ tests/",
    "check": "bunx @biomejs/biome ci src/ tests/ && bun run tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "semver": "^7.8.5"
  }
}

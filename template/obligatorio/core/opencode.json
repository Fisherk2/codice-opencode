{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/big-pickle",
  "small_model": "opencode/nemotron-3.5-lightning-free",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 10000
  },
  "agents": {
    "huitzilopochtli": {
      "model": "opencode/mimo-v2.5-free",
      "color": "#d3e22b",
      "request": {
        "body": {
          "temperature": 0.5
        }
      },
      "steps": 50
    },
    "quetzalcoatl": {
      "model": "opencode/nemotron-3-ultra-free",
      "color": "#ffffff",
      "request": {
        "body": {
          "temperature": 0.2
        }
      },
      "steps": 120
    },
    "moctezuma": {
      "model": "opencode/big-pickle",
      "color": "#8B4513",
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "steps": 100
    },
    "tlaloc": {
      "model": "opencode/nemotron-3.5-lightning-free",
      "color": "#00ffff",
      "request": {
        "body": {
          "temperature": 0.2
        }
      },
      "steps": 200
    },
    "mictlantecuhtli": {
      "model": "opencode/muse-spark-1.3-contributor-free",
      "color": "#2d2d2d",
      "request": {
        "body": {
          "temperature": 0.2
        }
      },
      "steps": 150
    },
    "tezcatlipoca": {
      "model": "opencode/mimo-v2.6-flash-free",
      "color": "#ff3134",
      "request": {
        "body": {
          "temperature": 0.1
        }
      },
      "steps": 100
    },
    "build": {
      "disabled": true
    },
    "plan": {
      "disabled": true
    },
    "explore": {
      "disabled": true
    },
    "general": {
      "disabled": true
    }
  },
  "instructions": [
    "CONTRIBUTING.md",
    "SPEC.md",
    "docs/ARCHITECTURE.md",
    "docs/CODE_STYLE.md"
  ],
  "references": {
    "clean-code": {
      "path": "./skills/clean-code/references",
      "description": "Reference materials for clean code principles, naming, functions, and formatting"
    },
    "codice-opencode": {
      "repository": "Fisherk2/codice-opencode",
      "branch": "main",
      "description": "Códice repository — OpenCode workspace installer reference"
    },
    "opencode": {
      "repository": "anomalyco/opencode",
      "branch": "dev",
      "description": "Official OpenCode repository — CLI, API, and configuration reference"
    }
  },
  "mcp": {
    "servers": {
      "codebase-memory-mcp": {
        "disabled": true
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "chrome-devtools": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@1.7.0"
        ],
        "disabled": true
      },
      "excel": {
        "type": "local",
        "command": [
          "uvx",
          "excel-mcp-server",
          "stdio"
        ],
        "disabled": true
      },
      "jupyter": {
        "type": "local",
        "command": [
          "uvx",
          "mcp-jupyter-notebook"
        ],
        "disabled": true,
        "env": {
          "MCP_JUPYTER_SESSION_MODE": "server",
          "MCP_JUPYTER_BASE_URL": "http://localhost:8888",
          "MCP_JUPYTER_TOKEN": "{env:MCP_JUPYTER_TOKEN}",
          "MCP_JUPYTER_NOTEBOOK_PATH": "agent_demo.ipynb"
        }
      },
      "tavily": {
        "type": "remote",
        "url": "https://mcp.tavily.com/mcp",
        "headers": {
          "TAVILY_API_KEY": "{env:TAVILY_API_KEY}"
        },
        "disabled": true
      },
      "firecrawl": {
        "type": "remote",
        "url": "https://mcp.firecrawl.dev/v2/mcp",
        "headers": {
          "FIRECRAWL_API_KEY": "{env:FIRECRAWL_API_KEY}"
        },
        "disabled": true
      },
      "vercel-grep": {
        "type": "remote",
        "url": "https://mcp.grep.app"
      },
      "gitmcp": {
        "type": "remote",
        "url": "https://gitmcp.io/docs"
      }
    }
  },
